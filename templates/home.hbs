<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Loyalty Card System</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      max-width: 800px;
      width: 100%;
      text-align: center;
    }

    .logo-section {
      margin-bottom: 40px;
      animation: fadeInDown 0.6s ease;
    }

    .logo-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      margin-bottom: 15px;
    }

    .logo-circle {
      width: 60px;
      height: 60px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .logo-circle img {
      width: 80%;
      height: 80%;
      object-fit: contain;
    }

    .brand-logo img {
      height: 60px;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.2));
    }

    h1 {
      color: white;
      font-size: 48px;
      font-weight: 700;
      margin-bottom: 10px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    }

    .subtitle {
      color: rgba(255,255,255,0.9);
      font-size: 18px;
      font-weight: 300;
      letter-spacing: 1px;
    }

    .search-section {
      background: white;
      border-radius: 20px;
      padding: 50px 40px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      animation: fadeInUp 0.6s ease;
    }

    .search-title {
      color: #2d3748;
      font-size: 24px;
      font-weight: 600;
      margin-bottom: 30px;
    }

    .search-form {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .input-wrapper {
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 20px 25px;
      font-size: 18px;
      border: 3px solid #e2e8f0;
      border-radius: 15px;
      outline: none;
      transition: all 0.3s ease;
      font-family: 'Courier New', monospace;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .search-input:focus {
      border-color: #14b8a6;
      box-shadow: 0 0 0 4px rgba(20,184,166,0.1);
    }

    .search-input::placeholder {
      text-transform: none;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      letter-spacing: normal;
    }

    .search-icon {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      color: #cbd5e0;
      pointer-events: none;
    }

    .search-btn {
      padding: 20px 40px;
      font-size: 18px;
      font-weight: 600;
      color: white;
      background: linear-gradient(135deg, #14b8a6 0%, #0891b2 100%);
      border: none;
      border-radius: 15px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(20,184,166,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .search-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(20,184,166,0.4);
    }

    .search-btn:active {
      transform: translateY(0);
    }

    .search-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .error-message {
      display: none;
      padding: 15px 20px;
      background: #fee2e2;
      color: #991b1b;
      border-radius: 10px;
      margin-top: 15px;
      font-size: 14px;
      animation: shake 0.5s ease;
    }

    .error-message.show {
      display: block;
    }

    .quick-links {
      margin-top: 30px;
      padding-top: 30px;
      border-top: 2px solid #f1f5f9;
    }

    .quick-links-title {
      color: #64748b;
      font-size: 14px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 15px;
    }

    .links-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }

    .quick-link {
      padding: 15px 20px;
      background: #f8fafc;
      color: #475569;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 500;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .quick-link:hover {
      background: #14b8a6;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(20,184,166,0.3);
    }

    .spinner {
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-10px); }
      75% { transform: translateX(10px); }
    }

    @media (max-width: 600px) {
      h1 {
        font-size: 36px;
      }

      .search-section {
        padding: 30px 25px;
      }

      .search-input {
        padding: 16px 20px;
        font-size: 16px;
      }

      .search-btn {
        padding: 16px 30px;
        font-size: 16px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo-section">
      <div class="logo-wrapper">
        <div class="logo-circle">
          <img src="/public/b-logo.svg" alt="Logo">
        </div>
        <div class="brand-logo">
          <img src="/public/logo.svg" alt="Brand">
        </div>
      </div>
      <h1>Loyalty Card System</h1>
      <p class="subtitle">Find your loyalty card instantly</p>
    </div>

    <div class="search-section">
      <h2 class="search-title">Search Loyalty Card</h2>

      <form class="search-form" onsubmit="searchCard(event)">
        <div class="input-wrapper">
          <input
            type="text"
            id="loyaltyInput"
            class="search-input"
            placeholder="Enter loyalty code (e.g., LOY-0001)"
            autocomplete="off"
            required
          >
          <svg class="search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>

        <button type="submit" class="search-btn" id="searchBtn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          Search Card
        </button>
      </form>

      <div class="error-message" id="errorMessage"></div>

      <div class="quick-links">
        <div class="quick-links-title">Quick Access</div>
        <div class="links-grid">
          <a href="/cards" class="quick-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
            All Cards
          </a>
          {{#if isDevelopment}}
          <a href="/test" class="quick-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            Test API
          </a>
          <a href="/debug-raw" class="quick-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            Debug Info
          </a>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <script>
    function searchCard(event) {
      event.preventDefault();

      const input = document.getElementById('loyaltyInput');
      const btn = document.getElementById('searchBtn');
      const errorMsg = document.getElementById('errorMessage');

      const loyaltyCode = input.value.trim().toUpperCase();

      if (!loyaltyCode) {
        showError('Please enter a loyalty code');
        return;
      }

      // Show loading state
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span> Searching...';
      errorMsg.classList.remove('show');

      // Navigate to card page
      window.location.href = `/card/${loyaltyCode}`;
    }

    function showError(message) {
      const errorMsg = document.getElementById('errorMessage');
      errorMsg.textContent = message;
      errorMsg.classList.add('show');
    }

    // Auto-focus on input
    document.getElementById('loyaltyInput').focus();

    // Format input as user types (optional enhancement)
    document.getElementById('loyaltyInput').addEventListener('input', function(e) {
      this.value = this.value.toUpperCase();
    });
  </script>
</body>
</html>
