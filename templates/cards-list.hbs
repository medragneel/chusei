<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>All Loyalty Cards - Chusei</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0a0a0f;
      color: #fff;
      min-height: 100vh;
      padding: 40px 20px;
    }

    /* Animated gradient background */
    .bg-gradient {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      opacity: 0.08;
      z-index: 0;
    }

    .bg-gradient::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 20% 50%, rgba(255, 0, 108, 0.3) 0%, transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(251, 251, 251, 0.2) 0%, transparent 50%);
      animation: pulse 8s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 1400px;
      margin: 0 auto;
    }

    /* Header */
    .header {
      margin-bottom: 60px;
      animation: fadeInDown 0.6s ease;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: rgba(255,255,255,0.6);
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 24px;
      transition: color 0.3s;
    }

    .back-link:hover {
      color: #fff;
    }

    .page-title {
      font-size: 48px;
      font-weight: 800;
      margin-bottom: 12px;
      background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.7) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .count-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 20px;
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      border-radius: 100px;
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      box-shadow: 0 4px 16px rgba(255, 0, 108, 0.3);
    }

    .page-description {
      font-size: 18px;
      color: rgba(255,255,255,0.6);
      max-width: 600px;
    }

    /* Table Card */
    .table-card {
      background: rgba(255,255,255,0.03);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px;
      padding: 0;
      overflow: hidden;
      box-shadow: 0 25px 50px rgba(0,0,0,0.3);
      animation: fadeInUp 0.6s ease;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: rgba(255,255,255,0.05);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    th {
      padding: 20px 24px;
      text-align: left;
      font-size: 12px;
      font-weight: 700;
      color: rgba(255,255,255,0.6);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    tbody tr {
      border-bottom: 1px solid rgba(255,255,255,0.05);
      transition: all 0.3s ease;
    }

    tbody tr:hover {
      background: rgba(255,255,255,0.05);
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    td {
      padding: 20px 24px;
      font-size: 15px;
      color: rgba(255,255,255,0.9);
    }

    .customer-name {
      font-weight: 600;
      color: #fff;
    }

    .loyalty-code {
      font-family: 'Courier New', monospace;
      padding: 6px 12px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      font-size: 13px;
      letter-spacing: 1px;
      color: rgba(255,255,255,0.8);
      display: inline-block;
    }

    .points {
      font-weight: 600;
      color: #fff;
    }

    .tier-badge {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      background: rgba(255, 0, 108, 0.1);
      border: 1px solid rgba(255, 0, 108, 0.3);
      color: #fca5cd;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
    }

    .status-badge.active {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #6ee7b7;
    }

    .status-badge.inactive {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .view-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      color: #fff;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      font-size: 13px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(255, 0, 108, 0.3);
    }

    .view-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(255, 0, 108, 0.4);
    }

    .empty-state {
      text-align: center;
      padding: 80px 40px;
    }

    .empty-icon {
      font-size: 64px;
      margin-bottom: 16px;
      opacity: 0.3;
    }

    .empty-text {
      font-size: 18px;
      color: rgba(255,255,255,0.5);
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 1024px) {
      .page-title {
        font-size: 36px;
        flex-direction: column;
        align-items: flex-start;
      }

      table {
        font-size: 14px;
      }

      th, td {
        padding: 16px 20px;
      }
    }

    @media (max-width: 768px) {
      .page-title {
        font-size: 32px;
      }

      .table-card {
        border-radius: 16px;
        overflow-x: auto;
      }

      table {
        min-width: 800px;
      }

      th, td {
        padding: 12px 16px;
        font-size: 13px;
      }
    }
  </style>
</head>
<body>
  <div class="bg-gradient"></div>

  <div class="container">
    <div class="header">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Back to Home
      </a>
      <h1 class="page-title">
        All Loyalty Cards
        <span class="count-badge">{{count}}</span>
      </h1>
      <p class="page-description">
        Complete list of all active and inactive loyalty cards in the system
      </p>
    </div>

    <div class="table-card">
      {{#if cards}}
      <table>
        <thead>
          <tr>
            <th>Customer</th>
            <th>Loyalty Code</th>
            <th>Points</th>
            <th>Tier</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each cards}}
          <tr>
            <td class="customer-name">{{customer}}</td>
            <td><code class="loyalty-code">{{loyaltyCode}}</code></td>
            <td class="points">{{points}}</td>
            <td><span class="tier-badge">{{tier}}</span></td>
            <td>
              <span class="status-badge {{#if active}}active{{else}}inactive{{/if}}">
                <span class="status-dot"></span>
                {{#if active}}Active{{else}}Inactive{{/if}}
              </span>
            </td>
            <td>
              <a href="{{url}}" class="view-link">
                View Card
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <div class="empty-state">
        <div class="empty-icon">📭</div>
        <p class="empty-text">No loyalty cards found</p>
      </div>
      {{/if}}
    </div>
  </div>
</body>
</html>
