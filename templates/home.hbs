<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Chusei Loyalty - Reward Your Journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0a0a0f;
      color: #fff;
      overflow-x: hidden;
    }

    /* Animated gradient background */
    .bg-gradient {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      opacity: 0.08;
      z-index: 0;
    }

    .bg-gradient::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 20% 50%, rgba(255, 0, 108, 0.3) 0%, transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(251, 251, 251, 0.2) 0%, transparent 50%);
      animation: pulse 8s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }

    .container {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      padding: 40px 20px;
    }

    /* Header/Nav */
    .nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1400px;
      margin: 0 auto 80px;
      padding: 20px 0;
    }

    .logo-nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .logo-icon img {
      width: 70%;
      height: 70%;
      object-fit: contain;
    }

    .brand-text {
      font-size: 24px;
      font-weight: 700;
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
    }

    .nav-link {
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
      transition: color 0.3s;
    }

    .nav-link:hover {
      color: #fff;
    }

    /* Hero Section */
    .hero {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      padding: 60px 0;
    }

    .hero-content {
      animation: fadeInLeft 1s ease;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(255, 0, 108, 0.1);
      border: 1px solid rgba(255, 0, 108, 0.3);
      border-radius: 100px;
      font-size: 13px;
      font-weight: 600;
      color: #fca5cd;
      margin-bottom: 24px;
      backdrop-filter: blur(10px);
    }

    .badge-dot {
      width: 8px;
      height: 8px;
      background: #ff006c;
      border-radius: 50%;
      animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes ping {
      75%, 100% {
        transform: scale(2);
        opacity: 0;
      }
    }

    h1 {
      font-size: 72px;
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 24px;
      background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.7) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .gradient-text {
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-description {
      font-size: 20px;
      line-height: 1.6;
      color: rgba(255,255,255,0.6);
      margin-bottom: 40px;
      max-width: 540px;
    }

    /* Search Card */
    .search-card {
      background: rgba(255,255,255,0.03);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px;
      padding: 40px;
      animation: fadeInRight 1s ease;
      box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .search-header {
      margin-bottom: 28px;
    }

    .search-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .search-subtitle {
      font-size: 14px;
      color: rgba(255,255,255,0.5);
    }

    .search-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .input-group {
      position: relative;
    }

    .input-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: rgba(255,255,255,0.7);
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .search-input {
      width: 100%;
      padding: 18px 24px 18px 56px;
      font-size: 16px;
      font-weight: 500;
      background: rgba(255,255,255,0.05);
      border: 2px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      color: #fff;
      outline: none;
      transition: all 0.3s ease;
      font-family: 'Courier New', monospace;
      letter-spacing: 1.5px;
    }

    .search-input::placeholder {
      color: rgba(255,255,255,0.3);
      font-family: 'Inter', sans-serif;
      letter-spacing: normal;
      font-weight: 400;
    }

    .search-input:focus {
      background: rgba(255,255,255,0.08);
      border-color: #ff006c;
      box-shadow: 0 0 0 4px rgba(255, 0, 108, 0.1);
    }

    .input-icon {
      position: absolute;
      left: 20px;
      bottom: 18px;
      color: rgba(255,255,255,0.4);
      pointer-events: none;
    }

    .search-btn {
      padding: 18px 32px;
      font-size: 16px;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(135deg, #ff006c 0%, #fbfbfb 100%);
      border: none;
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 24px rgba(255, 0, 108, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .search-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transition: left 0.5s;
    }

    .search-btn:hover::before {
      left: 100%;
    }

    .search-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(255, 0, 108, 0.5);
    }

    .search-btn:active {
      transform: translateY(0);
    }

    .search-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    /* Features Grid */
    .features {
      max-width: 1400px;
      margin: 100px auto 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
    }

    .feature-card {
      background: rgba(255,255,255,0.02);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 32px;
      transition: all 0.3s ease;
    }

    .feature-card:hover {
      background: rgba(255,255,255,0.04);
      border-color: rgba(255, 0, 108, 0.3);
      transform: translateY(-4px);
    }

    .feature-icon {
      width: 56px;
      height: 56px;
      background: linear-gradient(135deg, rgba(255, 0, 108, 0.1) 0%, rgba(251, 251, 251, 0.05) 100%);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }

    .feature-icon svg {
      color: #ff006c;
    }

    .feature-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .feature-description {
      font-size: 14px;
      line-height: 1.6;
      color: rgba(255,255,255,0.5);
    }

    /* Video Tutorial Section */
    .video-section {
      max-width: 1400px;
      margin: 100px auto 0;
      text-align: center;
    }

    .video-header {
      margin-bottom: 48px;
    }

    .video-title {
      font-size: 40px;
      font-weight: 800;
      margin-bottom: 16px;
      background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.7) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .video-subtitle {
      font-size: 18px;
      color: rgba(255,255,255,0.6);
      max-width: 600px;
      margin: 0 auto;
    }

    .video-container {
      position: relative;
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0,0,0,0.4);
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
    }

    .video-wrapper {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 aspect ratio */
      height: 0;
      overflow: hidden;
    }

    .video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    /* Quick Links */
    .quick-access {
      max-width: 1400px;
      margin: 60px auto 0;
      text-align: center;
    }

    .quick-access-title {
      font-size: 14px;
      font-weight: 600;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 24px;
    }

    .quick-links {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .quick-link {
      padding: 12px 24px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      border-radius: 12px;
      font-weight: 500;
      font-size: 14px;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .quick-link:hover {
      background: rgba(255, 0, 108, 0.1);
      border-color: rgba(255, 0, 108, 0.3);
      color: #fff;
      transform: translateY(-2px);
    }

    .spinner {
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.2);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes fadeInLeft {
      from {
        opacity: 0;
        transform: translateX(-40px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeInRight {
      from {
        opacity: 0;
        transform: translateX(40px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 60px;
      }

      h1 {
        font-size: 56px;
      }

      .features {
        grid-template-columns: 1fr;
      }

      .video-title {
        font-size: 32px;
      }

      .video-subtitle {
        font-size: 16px;
      }
    }

    @media (max-width: 640px) {
      .nav {
        flex-direction: column;
        gap: 20px;
        margin-bottom: 60px;
      }

      h1 {
        font-size: 40px;
      }

      .hero-description {
        font-size: 18px;
      }

      .search-card {
        padding: 28px;
      }

      .video-title {
        font-size: 28px;
      }

      .video-container {
        max-width: 100%;
      }

      .quick-links {
        flex-direction: column;
      }

      .quick-link {
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <div class="bg-gradient"></div>

  <div class="container">
    <!-- Navigation -->
    <nav class="nav">
      <div class="logo-nav">
        <div class="logo-icon">
          <img src="/public/chusei-logo.svg" alt="Chusei Logo">
        </div>
        <span class="brand-text"></span>
      </div>
      <div class="nav-links">
        <a href="/" class="nav-link">Home</a>
        <a href="/cards" class="nav-link">Cards</a>
        {{#if isDevelopment}}
        <a href="/debug-raw" class="nav-link">Debug</a>
        {{/if}}
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <div class="badge">
          <span class="badge-dot"></span>
          Powered by Notion API & Node.js
        </div>
        <h1>
          Every Purchase,<br>
          Every <span class="gradient-text">Reward</span>
        </h1>
        <p class="hero-description">
          Experience the future of loyalty rewards. Track your points, unlock exclusive benefits, and get rewarded for every journey with Chusei.
        </p>
      </div>

      <div class="search-card">
        <div class="search-header">
          <h2 class="search-title">Find Your Card</h2>
          <p class="search-subtitle">Enter your loyalty code to access your rewards</p>
        </div>

        <form class="search-form" onsubmit="searchCard(event)">
          <div class="input-group">
            <label class="input-label">Loyalty Code</label>
            <input
              type="text"
              id="loyaltyInput"
              class="search-input"
              placeholder="LOY-0001"
              autocomplete="off"
              required
            >
            <svg class="input-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>

          <button type="submit" class="search-btn" id="searchBtn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <span>Access My Card</span>
          </button>
        </form>
      </div>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <h3 class="feature-title">Personalized Experience</h3>
        <p class="feature-description">Every card is unique. Track your journey, view your tier status, and unlock personalized rewards.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        </div>
        <h3 class="feature-title">Real-Time Updates</h3>
        <p class="feature-description">Points updated instantly. Watch your rewards grow in real-time with every purchase.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="feature-title">Secure & Private</h3>
        <p class="feature-description">Your data is protected with enterprise-grade security. Access your card anytime, anywhere.</p>
      </div>
    </section>

    <!-- Video Tutorial -->
    <section class="video-section">
      <div class="video-header">
        <h2 class="video-title">How It Works</h2>
        <p class="video-subtitle">Watch this quick tutorial to learn how to use your Chusei loyalty card and maximize your rewards</p>
      </div>

      <div class="video-container">
        <div class="video-wrapper">
          <iframe
            src="https://www.youtube.com/embed/dQw4w9WgXcQ"
            title="Chusei Loyalty Tutorial"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Quick Access -->
    <section class="quick-access">
      <div class="quick-access-title">Quick Access</div>
      <div class="quick-links">
        <a href="/cards" class="quick-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          View All Cards
        </a>
        {{#if isDevelopment}}
        <a href="/test" class="quick-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          Test API
        </a>
        <a href="/debug-raw" class="quick-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          Debug Info
        </a>
        {{/if}}
      </div>
    </section>
  </div>

  <script>
    function searchCard(event) {
      event.preventDefault();

      const input = document.getElementById('loyaltyInput');
      const btn = document.getElementById('searchBtn');

      const loyaltyCode = input.value.trim().toUpperCase();

      if (!loyaltyCode) {
        input.focus();
        return;
      }

      // Show loading state
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner"></span><span>Searching...</span>';

      // Navigate to card page
      window.location.href = `/card/${loyaltyCode}`;
    }

    // Auto-focus on input
    document.getElementById('loyaltyInput').focus();

    // Format input as user types
    document.getElementById('loyaltyInput').addEventListener('input', function(e) {
      this.value = this.value.toUpperCase();
    });
  </script>
</body>
</html>
