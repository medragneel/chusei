<!DOCTYPE html>
<html>
<head>
  <title>Error</title>
  <style>
    body{
      font-family:Arial;
      display:flex;
      justify-content:center;
      align-items:center;
      min-height:100vh;
      background:#ef4444;
      color:white;
      text-align:center;
      padding:20px;
    }
    .error-container{
      max-width:600px;
    }
    h1{
      font-size:48px;
      margin-bottom:20px;
    }
    p{
      font-size:18px;
      opacity:0.9;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <h1>⚠️ Error</h1>
    <p>{{message}}</p>
  </div>
</body>
</html>
